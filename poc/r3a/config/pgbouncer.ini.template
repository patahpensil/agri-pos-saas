; PgBouncer — mode transaksi (pengganti terdekat perilaku Hyperdrive). Dibuat dari template oleh setup.sh.
[databases]
poc = host=@SOCK@ port=@PG_PORT@ dbname=poc

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = @PGB_PORT@
unix_socket_dir =
auth_type = trust
auth_file = @RUNTIME@/pgb/userlist.txt
pool_mode = transaction
default_pool_size = 2
max_client_conn = 500
max_prepared_statements = 100
ignore_startup_parameters = extra_float_digits
logfile = @RUNTIME@/pgb/pgbouncer.log
pidfile = @RUNTIME@/pgb/pgbouncer.pid
