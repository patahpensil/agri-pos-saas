; HANYA UNTUK UJI (CI/lokal). auth_type=trust dan userlist tanpa sandi DILARANG di produksi.
[databases]
@DB@ = host=@PGHOST@ port=@PGPORT@ dbname=@DB@
; Alias dengan 1 koneksi server: dipakai kontrol negatif T-TENANT-03-KONTROL.
@DB@_pool1 = host=@PGHOST@ port=@PGPORT@ dbname=@DB@ pool_size=1

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = @PGB_PORT@
unix_socket_dir =
auth_type = trust
auth_file = @DIR@/userlist.txt
pool_mode = transaction
default_pool_size = 5
max_client_conn = 500
max_prepared_statements = 100
ignore_startup_parameters = extra_float_digits,application_name
logfile = @DIR@/pgbouncer.log
pidfile = @DIR@/pgbouncer.pid
